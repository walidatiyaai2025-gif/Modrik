{
  "name": "modrik-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "runtime:mocks:check": "node --test scripts/validate-no-runtime-mocks.test.mjs && node scripts/validate-no-runtime-mocks.mjs",
    "contracts:check": "npm run runtime:mocks:check && node --test scripts/capability-surface-contract.test.mjs && node scripts/validate-capability-surface.mjs && node scripts/validate-contracts.mjs && node --test scripts/demo-deployment-smoke.test.mjs && node --test scripts/demo-cloudlinux-restart-contract.test.mjs && node --test scripts/deployment-constitution-contract.test.mjs",
    "brand:icons": "node scripts/generate-mobile-icons.mjs",
    "openapi:lint": "redocly lint docs/api/openapi.yaml",
    "tokens:check": "npm --prefix packages/design-tokens test",
    "pilot:smoke": "node scripts/pilot-smoke-runner.mjs",
    "pilot:smoke:test": "node --test scripts/pilot-smoke-process.test.mjs",
    "pilot:smoke:plan": "npm run pilot:smoke:test && node scripts/pilot-smoke.mjs --plan",
    "pilot:smoke:strict": "node scripts/pilot-smoke-runner.mjs --strict",
    "pilot:smoke:clean": "bash scripts/pilot-smoke-clean.sh",
    "web:build": "npm --prefix apps/web run build",
    "web:lint": "npm --prefix apps/web run lint",
    "web:test": "npm --prefix apps/web run test"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@redocly/cli": "2.46.2",
    "png-to-ico": "3.0.2",
    "yaml": "2.9.0"
  }
}
