# MODRIK Demo Backend / Laravel environment
# Copy to the deployed Backend as .env and replace every REPLACE_* value.
# Keep this file and all live values outside version control/public Web roots.

APP_NAME=MODRIK
APP_ENV=production
APP_KEY=REPLACE_WITH_PHP_ARTISAN_KEY_GENERATE_VALUE
APP_DEBUG=false
APP_URL=https://api.demo.modrik.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Demo-only synthetic fixture boundary. Keep the token identical to the Web
# Node application value and restrict the Demo environment from public abuse.
MODRIK_FIXTURE_MODE=true
MODRIK_FIXTURE_BEARER_TOKEN=REPLACE_WITH_RANDOM_DEMO_ONLY_TOKEN
MODRIK_IDEMPOTENCY_SECRET=REPLACE_WITH_RANDOM_SECRET
MODRIK_AUTH_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET

# Demo learner bootstrap. Both values are consumed only while fixture mode is
# enabled and update the existing synthetic learner rather than creating a new
# unrelated account. Keep the live password outside source control.
MODRIK_DEMO_STUDENT_EMAIL=REPLACE_WITH_DEMO_STUDENT_EMAIL
MODRIK_DEMO_STUDENT_PASSWORD=REPLACE_WITH_STRONG_DEMO_STUDENT_PASSWORD

# Optional Demo system-admin bootstrap. These values are consumed only by
# db:seed while fixture mode is enabled. Use a unique email and strong password.
MODRIK_DEMO_ADMIN_EMAIL=REPLACE_WITH_DEMO_ADMIN_EMAIL
MODRIK_DEMO_ADMIN_PASSWORD=REPLACE_WITH_STRONG_DEMO_ADMIN_PASSWORD

MODRIK_AUTH_SESSION_TTL_MINUTES=43200
MODRIK_AUTH_RECENT_SECONDS=600
MODRIK_AUTH_VERIFICATION_TTL_MINUTES=60
MODRIK_AUTH_RECOVERY_TTL_MINUTES=30
MODRIK_AUTH_PROVIDER_INTENT_TTL_MINUTES=10
MODRIK_AUTH_LOGIN_MAX_ATTEMPTS=8
MODRIK_AUTH_LOGIN_DECAY_SECONDS=900
MODRIK_AUTH_RESEND_MAX_ATTEMPTS=3
MODRIK_AUTH_RESEND_DECAY_SECONDS=900
MODRIK_AUTH_RECOVERY_MAX_ATTEMPTS=3
MODRIK_AUTH_RECOVERY_DECAY_SECONDS=900

# Production identity-provider integrations stay intentionally disabled in Demo
# unless the owner later supplies real provider configuration.
MODRIK_GOOGLE_CLIENT_ID=
MODRIK_GOOGLE_CLIENT_SECRET=
MODRIK_GOOGLE_CALLBACK_URL=
MODRIK_APPLE_CLIENT_ID=
MODRIK_APPLE_TEAM_ID=
MODRIK_APPLE_KEY_ID=
MODRIK_APPLE_PRIVATE_KEY=
MODRIK_APPLE_CALLBACK_URL=

MODRIK_PAID_AI_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_CPANEL_DATABASE
DB_USERNAME=REPLACE_WITH_CPANEL_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_CPANEL_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@modrik.org
MAIL_FROM_NAME=MODRIK

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
