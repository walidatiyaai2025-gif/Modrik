# MODRIK Demo Student Web / Next.js server environment
# Copy these values into cPanel Setup Node.js App environment variables.
# Do NOT upload this file as a live secret file without replacing placeholders.

NODE_ENV=production
HOSTNAME=0.0.0.0

# Recommended: deploy Laravel on a separate cPanel subdomain such as
# https://api.demo.modrik.org and put that exact origin here.
MODRIK_API_BASE_URL=https://api.demo.modrik.org
MODRIK_ADMIN_PORTAL_URL=https://api.demo.modrik.org/admin/login

# Optional synthetic evaluation mode. If enabled, this token MUST match the
# Backend demo value and remain server-side/external. Use a long random value.
MODRIK_FIXTURE_MODE=true
MODRIK_FIXTURE_BEARER_TOKEN=REPLACE_WITH_RANDOM_DEMO_ONLY_TOKEN
