APP_NAME=MODRIK
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Synthetic BOOT-008 data/auth only. Keep disabled outside local fixture environments.
MODRIK_FIXTURE_MODE=true
MODRIK_FIXTURE_BEARER_TOKEN=modrik-local-fixture-token
MODRIK_IDEMPOTENCY_SECRET=

# Production Auth lifecycle tuning. Keep the hash secret external; APP_KEY is the fallback.
MODRIK_AUTH_HASH_SECRET=
MODRIK_AUTH_SESSION_TTL_MINUTES=43200
MODRIK_AUTH_RECENT_SECONDS=600
MODRIK_AUTH_VERIFICATION_TTL_MINUTES=60
MODRIK_AUTH_RECOVERY_TTL_MINUTES=30
MODRIK_AUTH_PROVIDER_INTENT_TTL_MINUTES=10
MODRIK_AUTH_LOGIN_MAX_ATTEMPTS=8
MODRIK_AUTH_LOGIN_DECAY_SECONDS=900
MODRIK_AUTH_RESEND_MAX_ATTEMPTS=3
MODRIK_AUTH_RESEND_DECAY_SECONDS=900
MODRIK_AUTH_RECOVERY_MAX_ATTEMPTS=3
MODRIK_AUTH_RECOVERY_DECAY_SECONDS=900

# Owner-provided production identity-provider inputs. Intentionally blank; never invent or commit live values.
MODRIK_GOOGLE_CLIENT_ID=
MODRIK_GOOGLE_CLIENT_SECRET=
MODRIK_GOOGLE_CALLBACK_URL=
MODRIK_APPLE_CLIENT_ID=
MODRIK_APPLE_TEAM_ID=
MODRIK_APPLE_KEY_ID=
MODRIK_APPLE_PRIVATE_KEY=
MODRIK_APPLE_CALLBACK_URL=

# The learning core must work with paid AI off. No paid-AI provider transport is configured in P0.
MODRIK_PAID_AI_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=modrik
DB_USERNAME=modrik
DB_PASSWORD=modrik_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@modrik.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
