<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # cPanel/LiteSpeed compatibility shim: if a vhost serves the Laravel
    # application root instead of the configured public/ directory, route
    # every request through public/ without exposing framework internals.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
