# Student Web talks only to the Backend through same-origin Route Handlers.
MODRIK_API_BASE_URL=http://localhost:8000

# Learning requests require the HttpOnly session cookie established by the real Auth lifecycle.
# No fixture/mock bearer fallback exists in the Web runtime.

# Google/Apple production client IDs, callbacks and signing material remain external owner inputs.
# Do not invent or commit them. Provider entry points render a pending/unconfigured state until supplied.
