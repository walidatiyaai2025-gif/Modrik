{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modrik.org/content-pack/v1/manifest.schema.json",
  "title": "MODRIK Returned Content Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preparation_request_id", "settings_hash", "pack_id", "created_at", "generator", "provenance", "archive_limits", "files"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "preparation_request_id": {"$ref": "#/$defs/ulid"},
    "settings_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pack_id": {"$ref": "#/$defs/ulid"},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "minLength": 1, "maxLength": 50}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_status", "contains_student_pii", "source_references"],
      "properties": {
        "rights_status": {"type": "string", "enum": ["synthetic_fixture", "owner_created", "licensed", "public_domain", "pending_review"]},
        "contains_student_pii": {"type": "boolean", "const": false},
        "source_references": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "archive_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_uncompressed_bytes", "declared_file_count"],
      "properties": {
        "declared_uncompressed_bytes": {"type": "integer", "minimum": 1, "maximum": 524288000},
        "declared_file_count": {"type": "integer", "minimum": 1, "maximum": 5000}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240},
          "media_type": {"type": "string", "enum": ["application/json", "image/png", "image/jpeg", "image/svg+xml", "audio/mpeg", "video/mp4"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 104857600}
        }
      }
    }
  },
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}
  }
}
