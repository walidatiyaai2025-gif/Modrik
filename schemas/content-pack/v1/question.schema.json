{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modrik.org/content-pack/v1/question.schema.json",
  "title": "MODRIK Content Pack Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "curriculum_node_reference", "content_version", "type", "prompt", "answer_contract", "explanation"],
  "properties": {
    "id": {"$ref": "#/$defs/ulid"},
    "curriculum_node_reference": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,99}$"},
    "content_version": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "enum": ["single_choice", "multiple_choice", "short_text", "numeric"]},
    "prompt": {"$ref": "localized-text.schema.json"},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
          "label": {"$ref": "localized-text.schema.json"}
        }
      }
    },
    "answer_contract": {"type": "object"},
    "explanation": {"$ref": "localized-text.schema.json"},
    "maximum_score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000, "default": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "single_choice"}}, "required": ["type"]},
      "then": {
        "required": ["options"],
        "properties": {
          "answer_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correct_option_id"],
            "properties": {"correct_option_id": {"type": "string"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "multiple_choice"}}, "required": ["type"]},
      "then": {
        "required": ["options"],
        "properties": {
          "answer_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correct_option_ids"],
            "properties": {
              "correct_option_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "short_text"}}, "required": ["type"]},
      "then": {
        "properties": {
          "answer_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accepted_answers", "case_sensitive"],
            "properties": {
              "accepted_answers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "case_sensitive": {"type": "boolean"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "numeric"}}, "required": ["type"]},
      "then": {
        "properties": {
          "answer_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "tolerance"],
            "properties": {
              "value": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}
  }
}
