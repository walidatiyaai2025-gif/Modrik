{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modrik.org/preparation/settings.schema.json",
  "title": "MODRIK Content Preparation Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["locales", "academic_scope", "content_types", "generation"],
  "properties": {
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["ar", "en", "fr"]}
    },
    "academic_scope": {"$ref": "#/$defs/academic_scope"},
    "content_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["lesson", "practice_quiz", "mock_exam"]}
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_answer_explanations", "maximum_questions_per_quiz", "paid_ai_required"],
      "properties": {
        "include_answer_explanations": {"type": "boolean"},
        "maximum_questions_per_quiz": {"type": "integer", "minimum": 1, "maximum": 200},
        "paid_ai_required": {"type": "boolean", "const": false}
      }
    }
  },
  "$defs": {
    "academic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_reference", "year_level", "subject_references"],
      "properties": {
        "track_reference": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,99}$"},
        "board_reference": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,99}$"}]},
        "syllabus_version": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 100}]},
        "year_level": {"type": "string", "minLength": 1, "maxLength": 40},
        "subject_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,99}$"}
        }
      }
    }
  }
}
