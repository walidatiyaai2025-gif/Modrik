{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modrik.org/question-bank/v1/import.schema.json",
  "title": "MODRIK Question Bank Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_request_id",
    "settings_hash",
    "pack_id",
    "generated_at",
    "prompt",
    "sources",
    "items",
    "warnings",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "modrik-question-bank-v1"
    },
    "preparation_request_id": {
      "$ref": "#/$defs/ulid"
    },
    "settings_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pack_id": {
      "$ref": "#/$defs/ulid"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt": {
      "$ref": "#/$defs/prompt"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "nullableBoundedText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "academicScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "academic_year",
        "track_reference",
        "subject",
        "unit",
        "topic",
        "skill"
      ],
      "properties": {
        "academic_year": {
          "$ref": "#/$defs/nullableBoundedText"
        },
        "track_reference": {
          "$ref": "#/$defs/nullableBoundedText"
        },
        "subject": {
          "$ref": "#/$defs/nullableBoundedText"
        },
        "unit": {
          "$ref": "#/$defs/nullableBoundedText"
        },
        "topic": {
          "$ref": "#/$defs/nullableBoundedText"
        },
        "skill": {
          "$ref": "#/$defs/nullableBoundedText"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    },
    "acceptedAnswers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_answers",
        "case_sensitive"
      ],
      "properties": {
        "accepted_answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "case_sensitive": {
          "type": "boolean"
        }
      }
    },
    "numericAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "tolerance"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "singleOptionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct_option_id"
      ],
      "properties": {
        "correct_option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "multiOptionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct_option_ids"
      ],
      "properties": {
        "correct_option_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "booleanAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct"
      ],
      "properties": {
        "correct": {
          "type": "boolean"
        }
      }
    },
    "orderedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct_order"
      ],
      "properties": {
        "correct_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "matchingAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct_pairs"
      ],
      "properties": {
        "correct_pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left_id",
              "right_id"
            ],
            "properties": {
              "left_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "right_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "sourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_page",
        "notes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation",
        "confidence",
        "generation_notes"
      ],
      "properties": {
        "derivation": {
          "type": "string",
          "enum": [
            "generated_derivative",
            "source_verbatim"
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        },
        "generation_notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "academic_scope",
        "learning_objective",
        "type",
        "language",
        "question_text",
        "answer_contract",
        "explanation",
        "hints",
        "difficulty",
        "source",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"
        },
        "academic_scope": {
          "$ref": "#/$defs/academicScope"
        },
        "learning_objective": {
          "$ref": "#/$defs/nullableBoundedText"
        },
        "type": {
          "type": "string",
          "enum": [
            "multiple_choice",
            "true_false",
            "numeric",
            "fill_blank",
            "short_answer",
            "matching",
            "ordering",
            "multi_select",
            "image_question",
            "reading_comprehension",
            "multi_step_math"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "maxLength": 35
        },
        "question_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer_contract": {
          "oneOf": [
            {
              "$ref": "#/$defs/singleOptionAnswer"
            },
            {
              "$ref": "#/$defs/multiOptionAnswer"
            },
            {
              "$ref": "#/$defs/booleanAnswer"
            },
            {
              "$ref": "#/$defs/numericAnswer"
            },
            {
              "$ref": "#/$defs/acceptedAnswers"
            },
            {
              "$ref": "#/$defs/orderedAnswer"
            },
            {
              "$ref": "#/$defs/matchingAnswer"
            }
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "hints": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Easy",
            "Medium",
            "Hard",
            "Revision",
            "Exam-style"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceLink"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple_choice"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/singleOptionAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multi_select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/multiOptionAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true_false"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/booleanAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "numeric"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/numericAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "fill_blank",
                  "short_answer"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/acceptedAnswers"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ordering"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/orderedAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "answer_contract": {
                "$ref": "#/$defs/matchingAnswer"
              }
            }
          }
        }
      ]
    }
  }
}
